# Database
DATABASE_URL="postgresql://user:password@localhost:5432/nexus_board?schema=public"

# NextAuth (Auth.js)
NEXTAUTH_SECRET="generate-with-openssl-rand-base64-32"
NEXTAUTH_URL="http://localhost:3000"

# Google OAuth (https://console.cloud.google.com/apis/credentials)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# JWT (same secret as NextAuth for Socket.io verification; or use separate if you prefer)
JWT_SECRET="same-as-NEXTAUTH_SECRET-or-separate"

# Client
NEXT_PUBLIC_SOCKET_URL="http://localhost:3001"
CLIENT_URL="http://localhost:3000"
